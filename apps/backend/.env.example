# Development
# Default ports match infra/docker/.env.dev.example.
# If local machine runs conflicting services (host postgres on 5432, etc.),
# override POSTGRES_PORT/REDIS_PORT in infra/docker/.env.dev AND this file.
DATABASE_URL="postgresql://gmd:gmd_dev_password@localhost:5432/gmd_dev?schema=public"
PORT=3001
NODE_ENV=development
REDIS_URL="redis://localhost:6379"

# --- Auth (Phase 1.1) ---
JWT_PRIVATE_KEY_PATH=./.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./.secrets/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
PRIVACY_POLICY_VERSION=1.1

# --- SMTP (Phase 1.1) ---
# 127.0.0.1 (не localhost) — на Windows localhost резолвится в IPv6 ::1, MailHog слушает IPv4
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GMD <no-reply@gmd.local>


# --- Invites (Phase 1.2) ---
INVITE_TTL_SECONDS=600
CLAIM_LANDING_BASE_URL=https://gmd.link28rus.ru

# --- Admin (admin-ro) ---
# comma-separated emails, case-insensitive
ADMIN_EMAILS=

# --- Password auth ---
AUTH_DEV_MODE=false
AUTH_DEV_SECRET=
PASSWORD_LOCK_AFTER=5
PASSWORD_LOCK_TTL_SECONDS=900
