generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsentSubjectType {
  USER
  CHILD
}

enum ConsentDocumentType {
  PRIVACY_POLICY
  TERMS_OF_USE
  CHILD_14PLUS
}

model ConsentRecord {
  id           String              @id @default(cuid())
  subjectType  ConsentSubjectType
  userId       String?
  childId      String?
  documentType ConsentDocumentType
  version      String
  acceptedAt   DateTime            @default(now())
  ip           String?
  userAgent    String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, acceptedAt])
  @@index([childId, documentType, acceptedAt])
  @@index([subjectType, documentType, version])
  @@map("consent_records")
}

enum UserRole {
  admin
  parent
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  emailVerifiedAt              DateTime?
  name                         String?
  firstName                    String?
  lastName                     String?
  middleName                   String?
  locale                       String    @default("ru")
  acceptedPrivacyPolicyVersion String?
  passwordHash                 String?
  pinHash                      String?
  pinUpdatedAt                 DateTime?
  role                         UserRole  @default(parent)
  blockedAt                    DateTime?
  blockedReason                String?
  blockedById                  String?
  lastSeenAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  memberships              Membership[]
  refreshTokens            RefreshToken[]
  otpCodes                 OtpCode[]
  consents                 ConsentRecord[]
  createdZones             Zone[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  audioSessionsRequested   AudioSession[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Family {
  id        String    @id @default(cuid())
  name      String    @default("Моя семья")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  children    Child[]
  invites     Invite[]
  zones       Zone[]

  @@map("families")
}

enum MembershipRole {
  owner
  parent
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  familyId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
  @@map("memberships")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Child {
  id                   String    @id @default(cuid())
  familyId             String
  name                 String
  dateOfBirth          DateTime?
  avatarKey            String?
  // Защита от удаления приложения (Device Admin на mobile-child).
  // Включается/выключается родителем из web-кабинета и требует установленного
  // User.pinHash — тем же PIN ребёнок потом подтверждает деактивацию в
  // системном диалоге Android. protectionEnabledBy хранит userId родителя для
  // аудита (важно в семьях с несколькими родителями).
  protectionEnabled    Boolean   @default(false)
  protectionEnabledAt  DateTime?
  protectionEnabledBy  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  family          Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  device          ChildDevice?
  invites         Invite[]
  consents        ConsentRecord[]
  locations       Location[]
  sosEvents       SosEvent[]
  trips           Trip[]
  zoneAssignments ZoneChildAssignment[]
  zoneEvents      ZoneEvent[]
  zoneStates      ZoneState[]
  audioSessions   AudioSession[]

  @@index([familyId])
  @@index([familyId, deletedAt])
  @@map("children")
}

model Invite {
  id                   String    @id @default(cuid())
  familyId             String
  childId              String
  code                 String    @unique
  expiresAt            DateTime
  consumedAt           DateTime?
  // Для детей 14+: родитель при создании invite обязан отметить, что получил
  // согласие ребёнка на обработку геолокации. Backend читает этот флаг при
  // claim — если granted=true, телефону ребёнка не требуется передавать
  // consent14Plus в теле запроса (согласие уже зафиксировано родителем).
  consent14PlusGranted Boolean   @default(false)
  createdBy            String
  createdAt            DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@index([childId, consumedAt])
  @@map("invites")
}

model ChildDevice {
  id         String    @id @default(cuid())
  childId    String    @unique
  tokenHash  String    @unique
  deviceName String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  child     Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  locations Location[]
  sosEvents SosEvent[]
  commands  DeviceCommand[]
  audioSessions AudioSession[]

  @@map("child_devices")
}

enum DeviceCommandType {
  PLAY_SIGNAL
  START_AUDIO
  STOP_AUDIO
}

enum DeviceCommandStatus {
  pending
  executed
  expired
  cancelled
}

// Команда от родителя к child-устройству. Доставляется short-polling:
// child-устройство при каждом ingest/heartbeat (≤ 2 мин) забирает pending
// команды и выполняет их. FCM-доставки на MVP нет.
//
// expiresAt отсекает «устаревшие» команды — если родитель нажал «Сигнал»
// 3 часа назад, а телефон только сейчас вышел в сеть, проигрывать уже
// не нужно.
model DeviceCommand {
  id              String              @id @default(cuid())
  childDeviceId   String
  type            DeviceCommandType
  status          DeviceCommandStatus @default(pending)
  payload         Json?
  createdByUserId String
  createdAt       DateTime            @default(now())
  expiresAt       DateTime
  executedAt      DateTime?

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@index([childDeviceId, status, expiresAt])
  @@map("device_commands")
}

model Location {
  id               String   @id @default(cuid())
  childId          String
  childDeviceId    String
  lat              Float
  lon              Float
  accuracy         Float?
  altitude         Float?
  speed            Float?
  bearing          Float?
  batteryLevel     Int?
  isCharging       Boolean?
  provider         String?
  networkType      String?
  wifiSsid         String?
  mobileOperator   String?
  recordedAt       DateTime
  serverReceivedAt DateTime @default(now())

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, recordedAt])
  @@index([childId, recordedAt(sort: Desc)])
  @@map("locations")
}

// Поездка — последовательность точек между остановками. Конец = ребёнок
// не сдвигался более TRIP_IDLE_MIN минут дальше TRIP_IDLE_RADIUS_M метров
// от точки остановки. isActive=true — последняя, незакрытая.
model Trip {
  id          String    @id @default(cuid())
  childId     String
  startedAt   DateTime
  endedAt     DateTime?
  isActive    Boolean   @default(true)
  pointsCount Int       @default(1)
  distanceM   Int       @default(0)
  startLat    Float
  startLon    Float
  endLat      Float
  endLon      Float
  updatedAt   DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, isActive])
  @@index([childId, startedAt(sort: Desc)])
  @@map("trips")
}

// ─── Audio Sessions ───────────────────────────────────────────────────────────

enum AudioSessionState {
  PENDING
  READY
  ACTIVE
  ENDED
  FAILED
  EXPIRED
}

enum AudioFailureReason {
  PERMISSION_DENIED
  MIC_BUSY
  OEM_BLOCKED
  NETWORK_ERROR
  CHILD_OFFLINE
  PARENT_TIMEOUT
  UNKNOWN
}

enum AudioAuditEvent {
  REQUESTED
  GRANTED
  STARTED
  STOPPED
  FAILED
  EXPIRED
  CONSENT_REVOKED
}

enum AudioIceSide {
  parent
  child
}

// Сессия аудиомониторинга «Звук вокруг ребёнка». Состояния:
// PENDING — родитель создал, child ещё не подтвердил готовность
// READY   — child прислал SDP-offer, ждём parent answer
// ACTIVE  — обмен ICE состоялся, аудио идёт
// ENDED   — штатное завершение
// FAILED  — ошибка (см. failureReason)
// EXPIRED — child не успел ответить за TIMEOUT_SEC
//
// Аудио НЕ хранится — только метаданные сессии и audit-log. Под 152-ФЗ это
// «обработка без накопления»; согласие фиксируется в ConsentRecord.
model AudioSession {
  id              String              @id @default(cuid())
  childId         String
  childDeviceId   String
  requestedById   String              // userId родителя
  state           AudioSessionState   @default(PENDING)
  hiddenMode      Boolean             @default(true)
  durationSec     Int                 // запрошенная длительность
  actualSec       Int?                // реальная длительность (NULL пока не ENDED)
  failureReason   AudioFailureReason?
  // SDP offer от child / answer от parent — короткие, OK хранить inline.
  sdpOffer        String?
  sdpAnswer       String?
  startedAt       DateTime            @default(now())
  readyAt         DateTime?
  activeAt        DateTime?
  endedAt         DateTime?
  // Billing-заготовка (post-MVP)
  billableMinutes Decimal?            @db.Decimal(5, 2)
  costKopecks     Int?

  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice   ChildDevice         @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  requestedBy   User                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  auditLog      AudioAuditLog[]
  iceCandidates AudioIceCandidate[]

  @@index([childId, startedAt(sort: Desc)])
  @@index([requestedById, startedAt(sort: Desc)])
  // Для concurrentSessionsPerChild=1: одна активная на child.
  @@index([childId, state], map: "audio_sessions_child_active_idx")
  @@map("audio_sessions")
}

// ICE candidates — буфер на случай, если parent SSE дисконнектнулся.
// Прямо отдаём через SSE и параллельно сохраняем; child poll'ит /ice.
model AudioIceCandidate {
  id        String       @id @default(cuid())
  sessionId String
  side      AudioIceSide
  candidate String
  createdAt DateTime     @default(now())
  consumed  Boolean      @default(false)

  session AudioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, side, consumed])
  @@map("audio_ice_candidates")
}

// Аудит для compliance. Retention 1 год (pg_cron). Не CASCADE-удаляется
// вместе с сессией — нужен для последующих юр.запросов.
// sessionId nullable: когда pg_cron удаляет session старше 90д, audit-записи
// остаются с sessionId=NULL (SET NULL). Сам audit self-contained в event +
// metadata + actorUserId, достаточно для compliance.
model AudioAuditLog {
  id          BigInt          @id @default(autoincrement())
  sessionId   String?
  event       AudioAuditEvent
  actorUserId String?
  actorIp     String?
  userAgent   String?         @db.VarChar(500)
  metadata    Json?           // failureReason, originalSessionId, etc.
  createdAt   DateTime        @default(now())

  session AudioSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("audio_audit_log")
}

// ─── App Settings ─────────────────────────────────────────────────────────────

// Глобальные настройки приложения. key/value строкой — админка правит
// через UI, backend читает с in-memory кэшем и инвалидацией на write.
// Используется для TRIP_IDLE_* (сегментация поездок) и будущих параметров.
model AppSetting {
  key         String   @id
  value       String
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("app_settings")
}

model SosEvent {
  id              String    @id @default(cuid())
  childId         String
  childDeviceId   String
  lat             Float
  lon             Float
  accuracy        Float?
  recordedAt      DateTime
  serverCreatedAt DateTime  @default(now())
  message         String?   @db.VarChar(500)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@index([childId, serverCreatedAt(sort: Desc)])
  @@map("sos_events")
}

model Zone {
  id        String    @id @default(cuid())
  familyId  String
  name      String    @db.VarChar(60)
  color     String
  icon      String
  centerLat Float
  centerLon Float
  radius    Int
  // PostGIS generated column `center_geo` существует в БД (см.
  // 20260420064916_phase4_zones_postgis), но в schema.prisma её НЕТ — Prisma 5
  // не умеет корректно описывать GENERATED ALWAYS AS. Поэтому каждый migrate
  // diff генерирует DROP для этой колонки; его нужно вручную вычистить из
  // migration.sql перед применением.
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator     User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  assignments ZoneChildAssignment[]
  events      ZoneEvent[]
  states      ZoneState[]

  @@index([familyId, deletedAt])
  @@map("zones")
}

model ZoneChildAssignment {
  id        String   @id @default(cuid())
  zoneId    String
  childId   String
  createdAt DateTime @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_child_assignments")
}

enum ZoneEventType {
  entry
  exit
}

model ZoneEvent {
  id         String        @id @default(cuid())
  zoneId     String
  childId    String
  type       ZoneEventType
  lat        Float
  lon        Float
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime      @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, recordedAt(sort: Desc)])
  @@index([zoneId, recordedAt(sort: Desc)])
  @@map("zone_events")
}

model ZoneState {
  id                  String    @id @default(cuid())
  zoneId              String
  childId             String
  isInside            Boolean   @default(false)
  pendingTransition   Boolean   @default(false)
  pendingSince        DateTime?
  lastConfirmedChange DateTime?
  updatedAt           DateTime  @updatedAt

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_states")
}
