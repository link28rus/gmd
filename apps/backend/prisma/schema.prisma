generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsentSubjectType {
  USER
  CHILD
}

enum ConsentDocumentType {
  PRIVACY_POLICY
  TERMS_OF_USE
  CHILD_14PLUS
}

model ConsentRecord {
  id           String              @id @default(cuid())
  subjectType  ConsentSubjectType
  userId       String?
  childId      String?
  documentType ConsentDocumentType
  version      String
  acceptedAt   DateTime            @default(now())
  ip           String?
  userAgent    String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, acceptedAt])
  @@index([childId, documentType, acceptedAt])
  @@index([subjectType, documentType, version])
  @@map("consent_records")
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  emailVerifiedAt              DateTime?
  name                         String?
  locale                       String    @default("ru")
  acceptedPrivacyPolicyVersion String?
  passwordHash                 String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  memberships   Membership[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  consents      ConsentRecord[]
  createdZones  Zone[]

  @@index([email])
  @@map("users")
}

model Family {
  id        String    @id @default(cuid())
  name      String    @default("Моя семья")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  children    Child[]
  invites     Invite[]
  zones       Zone[]

  @@map("families")
}

enum MembershipRole {
  owner
  parent
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  familyId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
  @@map("memberships")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Child {
  id          String    @id @default(cuid())
  familyId    String
  name        String
  dateOfBirth DateTime?
  avatarKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  family     Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  device     ChildDevice?
  invites    Invite[]
  consents   ConsentRecord[]
  locations  Location[]
  sosEvents  SosEvent[]
  zoneAssignments ZoneChildAssignment[]
  zoneEvents      ZoneEvent[]
  zoneStates      ZoneState[]

  @@index([familyId])
  @@index([familyId, deletedAt])
  @@map("children")
}

model Invite {
  id         String    @id @default(cuid())
  familyId   String
  childId    String
  code       String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@index([childId, consumedAt])
  @@map("invites")
}

model ChildDevice {
  id         String    @id @default(cuid())
  childId    String    @unique
  tokenHash  String    @unique
  deviceName String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  child      Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  locations  Location[]
  sosEvents  SosEvent[]

  @@map("child_devices")
}

model Location {
  id               String   @id @default(cuid())
  childId          String
  childDeviceId    String
  lat              Float
  lon              Float
  accuracy         Float?
  altitude         Float?
  speed            Float?
  bearing          Float?
  batteryLevel     Int?
  isCharging       Boolean?
  provider         String?
  networkType      String?
  wifiSsid         String?
  mobileOperator   String?
  recordedAt       DateTime
  serverReceivedAt DateTime @default(now())

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, recordedAt])
  @@index([childId, recordedAt(sort: Desc)])
  @@map("locations")
}

model SosEvent {
  id              String    @id @default(cuid())
  childId         String
  childDeviceId   String
  lat             Float
  lon             Float
  accuracy        Float?
  recordedAt      DateTime
  serverCreatedAt DateTime  @default(now())
  message         String?   @db.VarChar(500)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@index([childId, serverCreatedAt(sort: Desc)])
  @@map("sos_events")
}

model Zone {
  id        String    @id @default(cuid())
  familyId  String
  name      String    @db.VarChar(60)
  color     String
  icon      String
  centerLat Float
  centerLon Float
  radius    Int
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator     User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  assignments ZoneChildAssignment[]
  events      ZoneEvent[]
  states      ZoneState[]

  @@index([familyId, deletedAt])
  @@map("zones")
}

model ZoneChildAssignment {
  id        String   @id @default(cuid())
  zoneId    String
  childId   String
  createdAt DateTime @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_child_assignments")
}

enum ZoneEventType {
  entry
  exit
}

model ZoneEvent {
  id         String        @id @default(cuid())
  zoneId     String
  childId    String
  type       ZoneEventType
  lat        Float
  lon        Float
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime      @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, recordedAt(sort: Desc)])
  @@index([zoneId, recordedAt(sort: Desc)])
  @@map("zone_events")
}

model ZoneState {
  id                  String    @id @default(cuid())
  zoneId              String
  childId             String
  isInside            Boolean   @default(false)
  pendingTransition   Boolean   @default(false)
  pendingSince        DateTime?
  lastConfirmedChange DateTime?
  updatedAt           DateTime  @updatedAt

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_states")
}
