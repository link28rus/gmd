generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  emailVerifiedAt              DateTime?
  name                         String?
  locale                       String    @default("ru")
  acceptedPrivacyPolicyVersion String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  memberships   Membership[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@index([email])
  @@map("users")
}

model Family {
  id        String    @id @default(cuid())
  name      String    @default("Моя семья")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  children    Child[]
  invites     Invite[]

  @@map("families")
}

enum MembershipRole {
  owner
  parent
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  familyId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
  @@map("memberships")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Child {
  id          String    @id @default(cuid())
  familyId    String
  name        String
  dateOfBirth DateTime?
  avatarKey   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  family  Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  device  ChildDevice?
  invites Invite[]

  @@index([familyId])
  @@index([familyId, deletedAt])
  @@map("children")
}

model Invite {
  id         String    @id @default(cuid())
  familyId   String
  childId    String
  code       String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@index([childId, consumedAt])
  @@map("invites")
}

model ChildDevice {
  id         String    @id @default(cuid())
  childId    String    @unique
  tokenHash  String    @unique
  deviceName String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_devices")
}
