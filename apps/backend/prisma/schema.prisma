generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsentSubjectType {
  USER
  CHILD
}

enum ConsentDocumentType {
  PRIVACY_POLICY
  TERMS_OF_USE
  CHILD_14PLUS
}

model ConsentRecord {
  id           String              @id @default(cuid())
  subjectType  ConsentSubjectType
  userId       String?
  childId      String?
  documentType ConsentDocumentType
  version      String
  acceptedAt   DateTime            @default(now())
  ip           String?
  userAgent    String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, acceptedAt])
  @@index([childId, documentType, acceptedAt])
  @@index([subjectType, documentType, version])
  @@map("consent_records")
}

enum UserRole {
  admin
  parent
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  emailVerifiedAt              DateTime?
  name                         String?
  firstName                    String?
  lastName                     String?
  middleName                   String?
  locale                       String    @default("ru")
  acceptedPrivacyPolicyVersion String?
  passwordHash                 String?
  role                         UserRole  @default(parent)
  blockedAt                    DateTime?
  blockedReason                String?
  blockedById                  String?
  lastSeenAt                   DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  memberships              Membership[]
  refreshTokens            RefreshToken[]
  otpCodes                 OtpCode[]
  consents                 ConsentRecord[]
  createdZones             Zone[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  audioSessionsRequested   AudioSession[]
  blockSessionsCreated     BlockSession[]
  appBlockSchedulesCreated AppBlockSchedule[]
  parentDevices            ParentDevice[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// v0.46: устройство родителя для FCM push (события геозон, SOS, низкий заряд).
/// Один пользователь может иметь несколько устройств (телефон + планшет).
/// fcmToken UNIQUE на уровне всей таблицы — Firebase возвращает один токен на
/// (project, app installation), и переустановка mobile-parent даёт новый токен,
/// старая запись помечается revoked при следующем POST /parents/devices/fcm-token.
model ParentDevice {
  id                String    @id @default(cuid())
  userId            String
  // v0.51 (lesson #24): fcmToken стал nullable — устройство без Google Play
  // Services может зарегистрироваться только через RuStore Push. БД CHECK
  // constraint гарантирует что хотя бы один из (fcmToken, rustorePushToken)
  // не NULL — см. миграцию 20260512120000_add_rustore_push_token.
  fcmToken          String?   @unique
  fcmTokenUpdatedAt DateTime  @default(now())
  // v0.51 RuStore Push (VKPNS) — параллельный канал доставки. Регистрируется
  // через POST /parents/devices/rustore-token при старте app если устройство
  // имеет RuStore client (RustorePushClient.available()=true).
  rustorePushToken           String?   @unique
  rustorePushTokenUpdatedAt  DateTime?
  platform          String    // "android" | "ios" — на MVP только android
  deviceName        String?   // model + manufacturer ("Xiaomi 22081212UG")
  appVersion        String?   // "0.46.0+1"
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("parent_devices")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Family {
  id        String    @id @default(cuid())
  name      String    @default("Моя семья")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  children    Child[]
  invites     Invite[]
  zones       Zone[]

  @@map("families")
}

enum MembershipRole {
  owner
  parent
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  familyId  String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
  @@map("memberships")
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Child {
  id                   String    @id @default(cuid())
  familyId             String
  name                 String
  dateOfBirth          DateTime?
  avatarKey            String?
  // Защита от удаления приложения (Device Admin на mobile-child).
  // Включается/выключается родителем из web-кабинета (простой тумблер,
  // без PIN — отменили в v0.29.x). protectionEnabledBy хранит userId родителя
  // для аудита (важно в семьях с несколькими родителями).
  protectionEnabled    Boolean   @default(false)
  protectionEnabledAt  DateTime?
  protectionEnabledBy  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  family          Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  device          ChildDevice?
  invites         Invite[]
  consents        ConsentRecord[]
  locations       Location[]
  sosEvents       SosEvent[]
  trips           Trip[]
  zoneAssignments ZoneChildAssignment[]
  zoneEvents      ZoneEvent[]
  zoneStates      ZoneState[]
  audioSessions   AudioSession[]

  @@index([familyId])
  @@index([familyId, deletedAt])
  @@map("children")
}

model Invite {
  id                   String    @id @default(cuid())
  familyId             String
  childId              String
  code                 String    @unique
  expiresAt            DateTime
  consumedAt           DateTime?
  // Для детей 14+: родитель при создании invite обязан отметить, что получил
  // согласие ребёнка на обработку геолокации. Backend читает этот флаг при
  // claim — если granted=true, телефону ребёнка не требуется передавать
  // consent14Plus в теле запроса (согласие уже зафиксировано родителем).
  consent14PlusGranted Boolean   @default(false)
  // v0.50.7: multi-use поддержка для тест-инвайтов модерации RuStore.
  // maxUses=1 (default) — классическое одноразовое поведение: при первом
  // успешном claim consumedAt=NOW(), повторный claim возвращает invite_invalid.
  // maxUses>1 — multi-use: claim инкрементит usesCount, consumedAt ставится
  // только когда usesCount >= maxUses. Если есть active ChildDevice — он
  // автоматически revoked (это OK для модерации: каждый новый модератор
  // получает свежее устройство, старая привязка снимается).
  // Создаётся через docker exec на проде для тест-аккаунта модератора;
  // обычные родительские invites всегда maxUses=1.
  maxUses              Int       @default(1)
  usesCount            Int       @default(0)
  createdBy            String
  createdAt            DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([familyId, consumedAt])
  @@index([childId, consumedAt])
  @@map("invites")
}

model ChildDevice {
  id         String    @id @default(cuid())
  childId    String    @unique
  tokenHash  String    @unique
  deviceName String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  // v0.37: FCM token для high-priority push (мгновенная доставка START_AUDIO).
  // Регистрируется через POST /child/devices/fcm-token при старте app и onTokenRefresh.
  // null = устройство ещё не зарегистрировало FCM (fresh install / нет Google Play Services) →
  // backend fallback'ится на poll-команду через DeviceCommand queue.
  fcmToken           String?   @unique
  fcmTokenUpdatedAt  DateTime?

  // v0.51 RuStore Push (lesson #24): параллельный канал доставки для устройств
  // без GMS (HMS Huawei, чистые AOSP, MIUI без GMS) либо у которых FCM был
  // зачищен MIUI Restricted Settings после sideload-update (lesson #23 —
  // решается переходом на RuStore-канал). Регистрируется через
  // POST /child/devices/rustore-token. push.service.ts шлёт через RuStore Push
  // API (vkpns.rustore.ru) если токен есть; FCM как fallback.
  rustorePushToken           String?   @unique
  rustorePushTokenUpdatedAt  DateTime?

  // v0.38: IANA timezone устройства ребёнка ("Europe/Moscow") — нужно для
  // корректной агрегации UsageBucket по local-date. Шлётся child'ом при
  // /usage-reports POST. NULL до первого репорта — UI парента в этом случае
  // показывает «нет данных».
  timezone           String?

  child         Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  locations     Location[]
  sosEvents     SosEvent[]
  commands      DeviceCommand[]
  audioSessions AudioSession[]
  installedApps InstalledApp[]
  usageBuckets  UsageBucket[]
  appRules      AppRule[]
  blockSessions BlockSession[]
  appBlockSchedules AppBlockSchedule[]

  @@map("child_devices")
}

enum DeviceCommandType {
  PLAY_SIGNAL
  START_AUDIO
  STOP_AUDIO
  AUDIO_ANSWER
}

enum DeviceCommandStatus {
  pending
  executed
  expired
  cancelled
}

// Команда от родителя к child-устройству. Доставляется short-polling:
// child-устройство при каждом ingest/heartbeat (≤ 2 мин) забирает pending
// команды и выполняет их. FCM-доставки на MVP нет.
//
// expiresAt отсекает «устаревшие» команды — если родитель нажал «Сигнал»
// 3 часа назад, а телефон только сейчас вышел в сеть, проигрывать уже
// не нужно.
model DeviceCommand {
  id              String              @id @default(cuid())
  childDeviceId   String
  type            DeviceCommandType
  status          DeviceCommandStatus @default(pending)
  payload         Json?
  createdByUserId String
  createdAt       DateTime            @default(now())
  expiresAt       DateTime
  executedAt      DateTime?

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@index([childDeviceId, status, expiresAt])
  @@map("device_commands")
}

model Location {
  id               String   @id @default(cuid())
  childId          String
  childDeviceId    String
  lat              Float
  lon              Float
  accuracy         Float?
  altitude         Float?
  speed            Float?
  bearing          Float?
  batteryLevel     Int?
  isCharging       Boolean?
  provider         String?
  networkType      String?
  wifiSsid         String?
  mobileOperator   String?
  recordedAt       DateTime
  serverReceivedAt DateTime @default(now())

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, recordedAt])
  @@index([childId, recordedAt(sort: Desc)])
  @@map("locations")
}

// Поездка — последовательность точек между остановками. Конец = ребёнок
// не сдвигался более TRIP_IDLE_MIN минут дальше TRIP_IDLE_RADIUS_M метров
// от точки остановки. isActive=true — последняя, незакрытая.
model Trip {
  id          String    @id @default(cuid())
  childId     String
  startedAt   DateTime
  endedAt     DateTime?
  isActive    Boolean   @default(true)
  pointsCount Int       @default(1)
  distanceM   Int       @default(0)
  startLat    Float
  startLon    Float
  endLat      Float
  endLon      Float
  updatedAt   DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, isActive])
  @@index([childId, startedAt(sort: Desc)])
  @@map("trips")
}

// ─── Audio Sessions ───────────────────────────────────────────────────────────

enum AudioSessionState {
  PENDING
  READY
  ACTIVE
  ENDED
  FAILED
  EXPIRED
}

enum AudioFailureReason {
  PERMISSION_DENIED
  MIC_BUSY
  OEM_BLOCKED
  NETWORK_ERROR
  CHILD_OFFLINE
  PARENT_TIMEOUT
  UNKNOWN
}

enum AudioAuditEvent {
  REQUESTED
  GRANTED
  STARTED
  STOPPED
  FAILED
  EXPIRED
  CONSENT_REVOKED
}

// Сессия аудиомониторинга «Звук вокруг ребёнка». v0.35: WebSocket-relay.
// Состояния:
// PENDING — родитель создал, child ещё не подключился к WS-relay
// ACTIVE  — оба клиента (child + parent) подключены, аудио идёт через backend
// ENDED   — штатное завершение
// FAILED  — ошибка (см. failureReason)
// EXPIRED — child не успел подключиться за readyTimeoutSec
//
// READY — устаревшее состояние из v0.32–v0.34 (WebRTC SDP exchange). Сохранено
// в enum только для обратной совместимости со старыми записями в БД; новый
// код его не использует.
//
// Аудио НЕ хранится — только метаданные сессии и audit-log. Под 152-ФЗ это
// «обработка без накопления»; согласие фиксируется в ConsentRecord.
model AudioSession {
  id              String              @id @default(cuid())
  childId         String
  childDeviceId   String
  requestedById   String              // userId родителя
  state           AudioSessionState   @default(PENDING)
  hiddenMode      Boolean             @default(true)
  durationSec     Int                 // запрошенная длительность
  actualSec       Int?                // реальная длительность (NULL пока не ENDED)
  failureReason   AudioFailureReason?
  startedAt       DateTime            @default(now())
  readyAt         DateTime?           // legacy v0.32–v0.34, не выставляется в v0.35
  activeAt        DateTime?
  endedAt         DateTime?
  // Billing-заготовка (post-MVP)
  billableMinutes Decimal?            @db.Decimal(5, 2)
  costKopecks     Int?

  child         Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice   ChildDevice         @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  requestedBy   User                @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  auditLog      AudioAuditLog[]

  @@index([childId, startedAt(sort: Desc)])
  @@index([requestedById, startedAt(sort: Desc)])
  // Для concurrentSessionsPerChild=1: одна активная на child.
  @@index([childId, state], map: "audio_sessions_child_active_idx")
  @@map("audio_sessions")
}

// Аудит для compliance. Retention 1 год (pg_cron). Не CASCADE-удаляется
// вместе с сессией — нужен для последующих юр.запросов.
// sessionId nullable: когда pg_cron удаляет session старше 90д, audit-записи
// остаются с sessionId=NULL (SET NULL). Сам audit self-contained в event +
// metadata + actorUserId, достаточно для compliance.
model AudioAuditLog {
  id          BigInt          @id @default(autoincrement())
  sessionId   String?
  event       AudioAuditEvent
  actorUserId String?
  actorIp     String?
  userAgent   String?         @db.VarChar(500)
  metadata    Json?           // failureReason, originalSessionId, etc.
  createdAt   DateTime        @default(now())

  session AudioSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("audio_audit_log")
}

// ─── App Settings ─────────────────────────────────────────────────────────────

// Глобальные настройки приложения. key/value строкой — админка правит
// через UI, backend читает с in-memory кэшем и инвалидацией на write.
// Используется для TRIP_IDLE_* (сегментация поездок) и будущих параметров.
model AppSetting {
  key         String   @id
  value       String
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("app_settings")
}

model SosEvent {
  id              String    @id @default(cuid())
  childId         String
  childDeviceId   String
  lat             Float
  lon             Float
  accuracy        Float?
  recordedAt      DateTime
  serverCreatedAt DateTime  @default(now())
  message         String?   @db.VarChar(500)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  child       Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@index([childId, serverCreatedAt(sort: Desc)])
  @@map("sos_events")
}

model Zone {
  id        String    @id @default(cuid())
  familyId  String
  name      String    @db.VarChar(60)
  color     String
  icon      String
  centerLat Float
  centerLon Float
  radius    Int
  // PostGIS generated column `center_geo` существует в БД (см.
  // 20260420064916_phase4_zones_postgis), но в schema.prisma её НЕТ — Prisma 5
  // не умеет корректно описывать GENERATED ALWAYS AS. Поэтому каждый migrate
  // diff генерирует DROP для этой колонки; его нужно вручную вычистить из
  // migration.sql перед применением.
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator     User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  assignments ZoneChildAssignment[]
  events      ZoneEvent[]
  states      ZoneState[]

  @@index([familyId, deletedAt])
  @@map("zones")
}

model ZoneChildAssignment {
  id        String   @id @default(cuid())
  zoneId    String
  childId   String
  createdAt DateTime @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_child_assignments")
}

enum ZoneEventType {
  entry
  exit
}

model ZoneEvent {
  id         String        @id @default(cuid())
  zoneId     String
  childId    String
  type       ZoneEventType
  lat        Float
  lon        Float
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime      @default(now())

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, recordedAt(sort: Desc)])
  @@index([zoneId, recordedAt(sort: Desc)])
  @@map("zone_events")
}

model ZoneState {
  id                  String    @id @default(cuid())
  zoneId              String
  childId             String
  isInside            Boolean   @default(false)
  pendingTransition   Boolean   @default(false)
  pendingSince        DateTime?
  lastConfirmedChange DateTime?
  updatedAt           DateTime  @updatedAt

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([zoneId, childId])
  @@index([childId])
  @@map("zone_states")
}

// ─── Phase 6 (v0.38): Screen-time reporting ──────────────────────────────────
// См. docs/superpowers/specs/2026-04-26-gmd-phase6-app-control.md
//
// На MVP — только сбор статистики использования приложений и список
// установленных apps (с иконками). Блокировка приложений (BlockSession,
// AppRule, UnlockRequest) добавится в v0.39/v0.40.

// Snapshot установленных приложений у ребёнка. Обновляется ежедневным
// InstalledAppsWorker'ом на mobile-child. Apps, исчезнувшие из payload
// >7 дней — soft-deleted (lastSeenAt смотрим в UI парента и серым выводим).
model InstalledApp {
  id            String   @id @default(cuid())
  childDeviceId String
  packageName   String   // "com.zhiliaoapp.musically"
  appLabel      String   // "TikTok"
  // SHA-256 raw PNG bytes иконки (см. AppIcon). NULL — иконку ещё не
  // успели зарезолвить (новый пакет, не успел загрузиться).
  iconSha256    String?
  // ApplicationInfo.FLAG_SYSTEM или FLAG_UPDATED_SYSTEM_APP. Системные
  // показываем (вариант A в дизайне), но визуально отделяем + не позволяем
  // блокировать звонки/SMS/камеру/Settings.
  isSystem      Boolean  @default(false)
  // Резолвится через app_categories.json seed. NULL → "other" в UI.
  category      String?

  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, packageName])
  @@index([childDeviceId])
  @@map("installed_apps")
}

// Глобальный кэш иконок приложений. Dedupe по sha256 — один и тот же TikTok
// у 1000 детей хранится один раз. PNG, max 96x96 RGBA, ≤100KB.
//
// На v0.38 хранится BYTEA прямо в БД (для упрощения deploy — MinIO bucket
// setup отложен). Ожидаемый объём: ~500 уникальных pkg/семья × 100KB = 50MB
// в самом плохом случае. При росте >10GB total — мигрируем в MinIO.
//
// Отдаётся через GET /app-icons/:sha256 с Cache-Control: public, max-age=31536000,
// immutable (sha256 — content-addressable, можно кэшировать вечно).
model AppIcon {
  sha256    String   @id      // SHA-256 raw PNG bytes (hex lowercase, 64 char)
  pngBytes  Bytes              // raw PNG content (max 100KB enforced на API уровне)
  bytes     Int                // размер для аналитики/лимитов (= length(pngBytes))
  createdAt DateTime @default(now())

  @@map("app_icons")
}

// Часовой bucket использования приложения. Ровно один rec на каждую
// (child, local-date, hour, package). UPSERT при POST /child/usage-reports.
// Retention 30 дней — pg_cron job (см. infra/postgres/init/).
//
// `seconds` агрегируется на child'е: child queryEvents UsageStats, считает
// время в каждом bucket'е по часам в local-TZ (TZ хранится в ChildDevice).
// Backend никаких пересчётов TZ не делает — просто записывает как есть.
model UsageBucket {
  id            String   @id @default(cuid())
  childDeviceId String
  date          DateTime @db.Date  // local-date в TZ ребёнка (см. ChildDevice.timezone)
  hour          Int                // 0..23
  packageName   String
  seconds       Int                // суммарно в этом часе

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, date, hour, packageName])
  @@index([childDeviceId, date])
  @@map("usage_buckets")
}

// ─── Phase 6.2 (v0.39): App Blocking Core ──────────────────────────────────
// См. docs/superpowers/specs/2026-04-26-gmd-phase6-app-control.md §5.
//
// Модель блокировки = whitelist + глобальный таймер (decision 2026-04-26):
// родитель запускает BlockSession{durationMin}, на child всё блокируется
// КРОМЕ AppRule{mode=ALWAYS_ALLOWED} (whitelist) + системных defaults
// (dialer/sms/camera/contacts/settings — резолвятся child'ом и UPSERT'ятся
// как AppRule{source=SYSTEM_DEFAULT, mode=ALWAYS_ALLOWED}).

enum AppRuleMode {
  // Подчиняется активной BlockSession (= блокируется когда сессия ACTIVE).
  // Default для всех новых apps.
  DEFAULT
  // Никогда не блокируется (whitelist). Игнорирует BlockSession.
  ALWAYS_ALLOWED
  // Блокируется ВСЕГДА, даже без активной сессии. Зарезервировано для v0.40.
  ALWAYS_BLOCKED
}

enum AppRuleSource {
  // Родитель явно настроил через UI.
  PARENT
  // Авто-резолвлено child'ом (default dialer/sms/camera/contacts/settings).
  // Backend UPSERT'ит при /child/installed-apps с payload.systemDefaults.
  SYSTEM_DEFAULT
  // Зашито в backend: ru.link28rus.gmd.child, ru.oneme.app — нельзя удалить.
  HARDCODED
}

// Per-(child × packageName) правило. Если правила нет → mode = DEFAULT.
// Один rule на пакет: при смене source/mode UPSERT по (childDeviceId, packageName).
// SYSTEM_DEFAULT можно перезаписать через PARENT (но не наоборот — backend
// не даст откатить PARENT обратно в SYSTEM_DEFAULT).
// HARDCODED резолвится в backend на чтении, в БД физически нет —
// иначе админу пришлось бы их seed'ить (см. compileEffectiveRules в сервисе).
model AppRule {
  id            String        @id @default(cuid())
  childDeviceId String
  packageName   String
  mode          AppRuleMode
  source        AppRuleSource

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)

  @@unique([childDeviceId, packageName])
  @@index([childDeviceId])
  @@map("app_rules")
}

enum BlockSessionState {
  ACTIVE          // endsAt > now, ребёнок видит overlay при попытке открыть DEFAULT app
  ENDED           // парент явно остановил (DELETE)
  EXPIRED         // auto-expired по endsAt (cron / OnModuleInit cleanup)
}

enum BlockEndReason {
  PARENT_STOPPED  // явный DELETE
  EXPIRED         // endsAt <= now
  UNLOCK_APPROVED // v0.40: парент одобрил UnlockRequest с decision=APPROVED_FULL
}

// Активная блокировка экрана ребёнка. Per-child максимум одна ACTIVE
// (валидируется на POST). startedAt + durationMin = endsAt — child получает
// absolute UTC timestamp endsAt (не зависит от system clock manipulation).
model BlockSession {
  id                String           @id @default(cuid())
  childDeviceId     String
  // Кто из родителей запустил. Для аудита и отображения в UI.
  createdByUserId   String

  state             BlockSessionState @default(ACTIVE)
  startedAt         DateTime          @default(now())
  endsAt            DateTime          // = startedAt + durationMin
  endedAt           DateTime?         // фактическое окончание (early stop / expired)
  endReason         BlockEndReason?

  childDevice ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  createdByUser User      @relation(fields: [createdByUserId], references: [id])

  @@index([childDeviceId, state])
  @@index([endsAt])  // для cron auto-expire / OnModuleInit cleanup
  @@map("block_sessions")
}

// Phase 6.x (v0.48): расписание автоблокировки приложений.
//
// Декларативные временные окна: «ПН–ПТ 22:00 → 08:00 — заблокировать всё кроме
// whitelist'а». Дополняет разовые BlockSession (ручные «заблокировать сейчас»).
// Расписание и сессия независимы; фактическая блокировка на устройстве =
// (active_session OR active_schedule) AND NOT (ALWAYS_ALLOWED OR HARDCODED).
//
// Время хранится как минуты с полуночи (Int 0..1439, exclusive end). TZ берём
// из ChildDevice.timezone (IANA, заполняется child'ом при usage-reports).
// Если start > end — расписание пересекает полночь (22:00 → 08:00).
//
// daysMask — 7-битная маска по ISO weekday (1=ПН … 7=ВС, bit i-1 = day i):
//   будни   = 0b0011111 = 31
//   выходные = 0b1100000 = 96
//   ежедневно = 0b1111111 = 127
enum AppBlockScheduleMode {
  // Блокировать всё кроме ALWAYS_ALLOWED + HARDCODED. Текущее (и единственное)
  // поведение, симметрично BlockSession. v2 может добавить BLOCK_LISTED.
  BLOCK_NON_ALLOWED
}

model AppBlockSchedule {
  id              String               @id @default(cuid())
  childDeviceId   String
  createdByUserId String

  name            String               @db.VarChar(64)
  enabled         Boolean              @default(true)

  daysMask        Int                  // 1..127 (см. выше)
  startMin        Int                  // 0..1439 (минуты с полуночи в TZ ребёнка)
  endMin          Int                  // 0..1439, exclusive; startMin == endMin запрещён DTO

  mode            AppBlockScheduleMode @default(BLOCK_NON_ALLOWED)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  childDevice   ChildDevice @relation(fields: [childDeviceId], references: [id], onDelete: Cascade)
  createdByUser User        @relation(fields: [createdByUserId], references: [id])

  @@index([childDeviceId, enabled])
  @@map("app_block_schedules")
}
