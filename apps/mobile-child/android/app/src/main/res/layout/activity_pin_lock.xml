<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_lock_lock"
        android:tint="#F59E0B"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gmd_pin_lock_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/pin_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gmd_pin_lock_subtitle"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/pin_input"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:gravity="center"
        android:textSize="28sp"
        android:letterSpacing="0.2"
        android:importantForAutofill="no"
        android:hint="••••"
        android:background="@android:drawable/edit_text"
        android:autofillHints=""
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="invisible"
        android:layout_marginBottom="16dp"
        android:text="" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pin_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gmd_pin_lock_cancel"
            android:textColor="#6B7280"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/pin_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gmd_pin_lock_confirm"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
