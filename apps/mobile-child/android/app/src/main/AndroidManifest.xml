<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- SignalSoundService (громкий сигнал от родителя) работает как
         media-playback foreground service: пользователь слышит звук,
         поэтому именно этот тип подходит. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Удерживаем CPU активным между GPS-callback'ами в foreground-сервисе,
         иначе Android Doze усыпляет процесс между обновлениями локации и
         мы теряем точки при заблокированном экране. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- «Звук вокруг ребёнка» (Phase 5.3) — захват микрофона по запросу родителя.
         FOREGROUND_SERVICE_MICROPHONE обязателен с Android 14 (API 34). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Защита от свайпа из recents: onTaskRemoved ставит AlarmManager-alarm
         через 3 сек, RestartReceiver поднимает сервис обратно. USE_EXACT_ALARM
         (Android 13+) granted автоматически для task-management приложений;
         на Android 12 fallback на setAndAllowWhileIdle. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- v0.31.0 Activity Recognition (Android 10+, Google Play Services).
         Используется LocationForegroundService чтобы при STILL-состоянии
         переключать FLP в режим 5-мин интервала и экономить батарею ребёнка.
         Permission optional: при отказе сервис работает в active-only режиме. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- v0.58.0: блокировка приложений и экранное время временно отключены —
         убраны PACKAGE_USAGE_STATS, SYSTEM_ALERT_WINDOW, служба спецвозможностей
         и <queries> для списка приложений. При возврате — восстановить из git. -->
    <!-- v0.56.0 самообновление с собственного сервера (AppUpdater.kt).
         REQUEST_INSTALL_PACKAGES — установка скачанного APK через PackageInstaller
         (пользователь один раз разрешает «Установку неизвестных приложений»).
         UPDATE_PACKAGES_WITHOUT_USER_ACTION (Android 12+) — обновление самого
         себя без диалога подтверждения.
         ВНИМАНИЕ: RuStore-модерация отклоняет сборки с REQUEST_INSTALL_PACKAGES
         (lesson #36) — перед возвратом в RuStore убрать или вынести во flavor. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>
    <!-- v0.60.0: свой Application (PeriscopApplication.kt) — обработчик падений
         и отправка журнала после падения на старте любого процесса. -->
    <application
        android:label="Перископ Ребёнка"
        android:name=".PeriscopApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- RuStore Push SDK (flutter_rustore_push). Project id берётся из
             android/rustore.properties через manifestPlaceholders (см.
             android/app/build.gradle.kts). Если значение пустое — runtime
             RustorePushClient.getToken() вернёт ошибку, мы это поймаем и
             деградируем на FCM-only push (см. core/push/rustore_push_registrar.dart). -->
        <meta-data
            android:name="ru.rustore.sdk.pushclient.project_id"
            android:value="${rustorePushProjectId}" />
        <service
            android:name=".LocationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <service
            android:name=".SignalSoundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- SoundAroundService — FGS для аудиомониторинга «Звук вокруг ребёнка».
             Стартует по START_AUDIO (realtime-канал, FCM или poll команд).
             Держит headless FlutterEngine, который пишет микрофон (record) и шлёт
             Opus-кадры на backend-relay по WebSocket.
             Останавливается по STOP_AUDIO команде или durationSec timeout. -->
        <service
            android:name=".SoundAroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Получает AlarmManager-alarm, запланированный в onTaskRemoved
             (после свайпа приложения из recents), и перезапускает сервис.
             exported=false — alarm приходит только от своего же процесса. -->
        <!-- v0.56.0: результат PackageInstaller-сессии самообновления. -->
        <receiver
            android:name=".AppUpdateStatusReceiver"
            android:exported="false"/>
        <receiver
            android:name=".RestartReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- AlarmManager-heartbeat: раз в 2 минуты сервис через этот ресивер
             просыпается и отправляет текущую точку. Заменяет Handler.postDelayed,
             который заморачивается MIUI после свайпа. -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.31.0 Activity Recognition transitions: Play Services шлёт
             broadcast'ы при смене активности (STILL/WALKING/IN_VEHICLE/…).
             Ресивер конвертирует их в intent-ы сервису, переключая профиль
             FLP (active 10с ↔ still 5мин) для экономии батареи. -->
        <receiver
            android:name=".ActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.36.0 — trampoline для запуска SoundAroundService через TempAllowList exemption.
             AlarmManager.setExactAndAllowWhileIdle → этот receiver получает ~10 сек exemption
             → может стартовать FGS-microphone из background (locked screen, headless isolate).
             Без trampoline'а Android 14 крашит startForeground(type=MICROPHONE) с SecurityException. -->
        <receiver
            android:name=".AudioStartTrampolineReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.37 — Firebase Cloud Messaging service для high-priority push.
             Backend шлёт data-message {type:START_AUDIO/STOP_AUDIO,...} —
             onMessageReceived стартует SoundAroundService. Это даёт latency
             3-5 сек вместо 60-120 сек poll-цикла. -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- L1-защита от удаления приложения. Пока Device Admin активен,
             Android блокирует стандартный Uninstall из Settings → Apps →
             «Перископ Ребёнка» — вместо этого показывается «Deactivate device
             administrator». Активация через ACTION_ADD_DEVICE_ADMIN
             (см. MainActivity.protection channel). -->
        <receiver
            android:name=".ChildDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
