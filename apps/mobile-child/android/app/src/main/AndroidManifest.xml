<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- SignalSoundService (громкий сигнал от родителя) работает как
         media-playback foreground service: пользователь слышит звук,
         поэтому именно этот тип подходит. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Удерживаем CPU активным между GPS-callback'ами в foreground-сервисе,
         иначе Android Doze усыпляет процесс между обновлениями локации и
         мы теряем точки при заблокированном экране. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Wi-Fi SSID для карточки ребёнка: на Android 10+ требует FINE_LOCATION
         (уже есть выше), на Android 12+ — NEARBY_WIFI_DEVICES. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- «Звук вокруг ребёнка» (Phase 5.3) — захват микрофона по запросу родителя.
         FOREGROUND_SERVICE_MICROPHONE обязателен с Android 14 (API 34). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Защита от свайпа из recents: onTaskRemoved ставит AlarmManager-alarm
         через 3 сек, RestartReceiver поднимает сервис обратно. USE_EXACT_ALARM
         (Android 13+) granted автоматически для task-management приложений;
         на Android 12 fallback на setAndAllowWhileIdle. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- v0.31.0 Activity Recognition (Android 10+, Google Play Services).
         Используется LocationForegroundService чтобы при STILL-состоянии
         переключать FLP в режим 5-мин интервала и экономить батарею ребёнка.
         Permission optional: при отказе сервис работает в active-only режиме. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- v0.38 Phase 6.1: screen-time reporting.
         PACKAGE_USAGE_STATS — special access (Settings → Special access → Usage data),
         используется UsageStatsManager.queryEvents для часовых bucket'ов.
         QUERY_ALL_PACKAGES — Android 11+ (API 30) требуется для PackageManager
         .getInstalledApplications чтобы вернуть полный список (не только наш).
         Парент-контроль — оправданное use-case по политике RuStore. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <!-- v0.39.4 Phase 6.2 fix: Android 12+ HyperOS блокирует startActivity()
         из background даже из AccessibilityService (Abort background activity
         starts). SYSTEM_ALERT_WINDOW даёт нашему процессу exemption на BAL +
         позволяет показывать TYPE_APPLICATION_OVERLAY поверх любого app.
         Special access — грантится через ACTION_MANAGE_OVERLAY_PERMISSION,
         не runtime. Без него блокировка деградирует до GLOBAL_ACTION_HOME
         (выкидывает на launcher без визуального overlay'а). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- v0.40 auto-update: после скачивания APK через Dio app дёргает системный
         installer (ACTION_VIEW + FileProvider URI). REQUEST_INSTALL_PACKAGES —
         special access (Settings → Установка из неизвестных источников),
         грантится один раз на наш package. Без него ACTION_VIEW показывает
         блокирующий «Запретить установку», а не наш installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="gmd_child"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <service
            android:name=".LocationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <service
            android:name=".SignalSoundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- SoundAroundService — FGS для аудиомониторинга «Звук вокруг ребёнка».
             Стартует по START_AUDIO команде из poll'а /child/commands/pending.
             Держит headless FlutterEngine, который через flutter_webrtc создаёт
             RTCPeerConnection и шлёт mic-stream на parent через TURN-сервер.
             Останавливается по STOP_AUDIO команде или durationSec timeout. -->
        <service
            android:name=".SoundAroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Получает AlarmManager-alarm, запланированный в onTaskRemoved
             (после свайпа приложения из recents), и перезапускает сервис.
             exported=false — alarm приходит только от своего же процесса. -->
        <receiver
            android:name=".RestartReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- AlarmManager-heartbeat: раз в 2 минуты сервис через этот ресивер
             просыпается и отправляет текущую точку. Заменяет Handler.postDelayed,
             который заморачивается MIUI после свайпа. -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.31.0 Activity Recognition transitions: Play Services шлёт
             broadcast'ы при смене активности (STILL/WALKING/IN_VEHICLE/…).
             Ресивер конвертирует их в intent-ы сервису, переключая профиль
             FLP (active 10с ↔ still 5мин) для экономии батареи. -->
        <receiver
            android:name=".ActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.36.0 — trampoline для запуска SoundAroundService через TempAllowList exemption.
             AlarmManager.setExactAndAllowWhileIdle → этот receiver получает ~10 сек exemption
             → может стартовать FGS-microphone из background (locked screen, headless isolate).
             Без trampoline'а Android 14 крашит startForeground(type=MICROPHONE) с SecurityException. -->
        <receiver
            android:name=".AudioStartTrampolineReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.37 — Firebase Cloud Messaging service для high-priority push.
             Backend шлёт data-message {type:START_AUDIO/STOP_AUDIO,...} —
             onMessageReceived стартует SoundAroundService. Это даёт latency
             3-5 сек вместо 60-120 сек poll-цикла. -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- L1-защита от удаления приложения. Пока Device Admin активен,
             Android блокирует стандартный Uninstall из Settings → Apps →
             gmd_child — вместо этого показывается «Deactivate device
             administrator». Активация через ACTION_ADD_DEVICE_ADMIN
             (см. MainActivity.protection channel). -->
        <receiver
            android:name=".ChildDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- v0.39 Phase 6.2: AccessibilityService реактивирован для блокировки
             приложений (PIN-lock остался удалён, защита от удаления — Device Admin L1).
             Ловит TYPE_WINDOW_STATE_CHANGED, проверяет packageName через BlockManager
             и при попадании в blacklist запускает BlockOverlayActivity. Грантится
             вручную: Settings → Accessibility → "Где мои дети — ребёнок". -->
        <service
            android:name=".GmdAccessibilityService"
            android:label="@string/accessibility_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- v0.40 auto-update: FileProvider для передачи скачанного APK
             системному installer'у через content:// URI. Authority строго
             "${packageName}.fileprovider" (используется в InstallerNative.kt).
             Пути ограничены external-cache/updates/ (см. res/xml/file_provider_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- v0.39 Phase 6.2: full-screen overlay при попытке открыть заблокированное app.
             excludeFromRecents=true — оверлей не висит в недавних задачах.
             showWhenLocked=true (manifest + setShowWhenLocked в Activity) — overlay
             перекрывает lockscreen. launchMode=singleTop — повторный startActivity
             не плодит дубли. theme — без ActionBar, NoActionBar.Fullscreen аналог. -->
        <activity
            android:name=".BlockOverlayActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
