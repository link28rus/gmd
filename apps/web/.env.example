# Backend URL — только server-side (Next.js API-routes)
# Dev: напрямую на NestJS. Prod: http://backend:3001 в docker-compose.
BACKEND_URL=http://127.0.0.1:3001

# Ключ Яндекс.Геокодера (server-side, не попадает в браузер)
# Используется для поиска адреса в редакторе геозон.
# Получить: https://developer.tech.yandex.ru → JavaScript API и HTTP Геокодер.
# Без ключа /api/geocode возвращает 503; редактор показывает "поиск недоступен".
YANDEX_GEOCODER_API_KEY=
