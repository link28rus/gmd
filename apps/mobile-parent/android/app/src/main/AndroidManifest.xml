<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- v0.46: для FCM push нужны permission показывать notifications (Android 13+)
         и keep-screen-awake (для high-priority data-message в Doze). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- v0.56.0 самообновление с собственного сервера (AppUpdater.kt).
         REQUEST_INSTALL_PACKAGES — установка скачанного APK через PackageInstaller
         (пользователь один раз разрешает «Установку неизвестных приложений»).
         UPDATE_PACKAGES_WITHOUT_USER_ACTION (Android 12+) — обновление самого
         себя без диалога подтверждения.
         ВНИМАНИЕ: RuStore-модерация отклоняет сборки с REQUEST_INSTALL_PACKAGES
         (lesson #36) — перед возвратом в RuStore убрать или вынести во flavor. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>
    <!-- v0.66.0: кнопка «Где я» на карте геозон (geolocator) — одна точка по
         нажатию, грубая точность (LocationAccuracy.low).
         v0.70.0: фоновая передача местоположения родителя семье
         (ParentLocationService, тумблер «Показывать меня семье»): FINE + COARSE,
         BACKGROUND («Разрешать всегда» — для автозапуска после перезагрузки,
         обновления и из сторожа), FGS type=location, автозапуск после
         перезагрузки, «без ограничений батареи». POST_NOTIFICATIONS объявлен
         выше — постоянное уведомление «Семья видит, где вы».
         Спека: docs/superpowers/specs/2026-10-08-family-map-parent-location.md -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- v0.70.0: onTaskRemoved ставит точный будильник на перезапуск службы
         геолокации (как у ребёнка) — он даёт исключение из запрета старта FGS
         из фона. Android 13+ выдаёт автоматически. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- v0.77.0: «Физическая активность» — Activity Recognition переключает
         ParentLocationService между «в движении» (GPS, 5 с) и «на месте»
         (экономно), как у ребёнка. Необязательное: без него служба работает
         по скорости точек и датчику движения. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- v0.73.0 «Найти телефон»: SignalSoundService (громкий сигнал по кнопке
         в личном кабинете) — media-playback foreground service, как у ребёнка;
         вибрация вместе со звуком. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:name="${applicationName}"
        android:label="Перископ Родителя"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- v0.46: Firebase Cloud Messaging — handler для входящих push-сообщений
             (события геозон, SOS и т.д.). Класс реализует FirebaseMessagingService
             и стартует системные notifications с deeplink на /home/child/{id}. -->
        <service
            android:name=".ParentFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- geolocator_android приносит свой foreground-сервис слежения — нам он не
             нужен («Где я» — одна точка по нажатию; фоновую передачу делает
             ParentLocationService), убираем. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            tools:node="remove"/>

        <!-- v0.70.0: фоновая передача местоположения родителя семье. -->
        <service
            android:name=".ParentLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <!-- v0.73.0: «Найти телефон» — громкий сигнал (FCM PLAY_SIGNAL или
             signal.id в ответе на отправку точек). -->
        <service
            android:name=".SignalSoundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- v0.70.0: перезапуск службы после свайпа из «Недавних» (будильник
             из ParentLocationService.onTaskRemoved). -->
        <receiver
            android:name=".ParentLocationRestartReceiver"
            android:enabled="true"
            android:exported="false"/>
        <!-- v0.77.0: события Activity Recognition (PendingIntent от Play Services)
             для ParentLocationService. -->
        <receiver
            android:name=".ParentActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false"/>

        <!-- v0.56.0: результат PackageInstaller-сессии самообновления. -->
        <receiver
            android:name=".AppUpdateStatusReceiver"
            android:exported="false"/>
        <!-- v0.56.0: новая версия встала — почистить кэш APK, позвать обратно
             уведомлением, если обновляли по кнопке.
             v0.70.0: после обновления и перезагрузки — поднять ParentLocationService. -->
        <receiver
            android:name=".AppUpdatedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Default notification icon и channel id для FCM (если payload не указывает иначе). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="periscop_parent_events" />

        <!-- Импеллер (Vulkan-рендер Flutter 3.24+) на Xiaomi/HyperOS вызывает
             AHardwareBuffer-ошибки и flutter_map TileLayer перестаёт запрашивать
             OSM-тайлы до первого user-event (карта остаётся серой). Форсим Skia
             пока flutter_map официально не зафиксит совместимость.
             См. https://github.com/fleaflet/flutter_map/issues/1822 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- RuStore Push SDK (flutter_rustore_push). Project id берётся из
             android/rustore.properties через manifestPlaceholders (см.
             android/app/build.gradle.kts). Если значение пустое — runtime
             RustorePushClient.getToken() вернёт ошибку, мы это поймаем и
             деградируем на FCM-only push (см. core/push/rustore_push_registrar.dart). -->
        <meta-data
            android:name="ru.rustore.sdk.pushclient.project_id"
            android:value="${rustorePushProjectId}" />

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Открытие точки в внешней карте (Yandex Maps / Google Maps / любая geo-handler). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- v0.72: url_launcher — политика/условия во внешнем браузере (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
