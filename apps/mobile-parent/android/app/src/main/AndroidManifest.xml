<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- v0.46: для FCM push нужны permission показывать notifications (Android 13+)
         и keep-screen-awake (для high-priority data-message в Doze). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:name="${applicationName}"
        android:label="Перископ Родителя"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- v0.46: Firebase Cloud Messaging — handler для входящих push-сообщений
             (события геозон, SOS и т.д.). Класс реализует FirebaseMessagingService
             и стартует системные notifications с deeplink на /home/child/{id}. -->
        <service
            android:name=".ParentFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification icon и channel id для FCM (если payload не указывает иначе). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="periscop_parent_events" />

        <!-- Импеллер (Vulkan-рендер Flutter 3.24+) на Xiaomi/HyperOS вызывает
             AHardwareBuffer-ошибки и flutter_map TileLayer перестаёт запрашивать
             OSM-тайлы до первого user-event (карта остаётся серой). Форсим Skia
             пока flutter_map официально не зафиксит совместимость.
             См. https://github.com/fleaflet/flutter_map/issues/1822 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- RuStore Push SDK (flutter_rustore_push). Project id берётся из
             android/rustore.properties через manifestPlaceholders (см.
             android/app/build.gradle.kts). Если значение пустое — runtime
             RustorePushClient.getToken() вернёт ошибку, мы это поймаем и
             деградируем на FCM-only push (см. core/push/rustore_push_registrar.dart). -->
        <meta-data
            android:name="ru.rustore.sdk.pushclient.project_id"
            android:value="${rustorePushProjectId}" />

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Открытие точки в внешней карте (Yandex Maps / Google Maps / любая geo-handler). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
    </queries>
</manifest>
