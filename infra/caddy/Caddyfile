{
	admin off
	auto_https off
}

# --- Основной кабинет + API (HTTP-режим, TLS терминирует внешний nginx) ---
:80 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "interest-cohort=()"
		-Server
	}

	respond /healthz "OK" 200

	log {
		output stdout
		format json
	}
}

# --- GlitchTip + Uptime Kuma subdomains ---
# Включаются в Phase 0.3 Task 16/17 через `import` после того как сервисы
# glitchtip-web и uptime-kuma появятся в docker-compose.prod.yml.
# Без этого Caddy пытается получить TLS-сертификат на subdomain и ACME падает,
# либо при обращении выдаёт 502 из-за отсутствия upstream DNS.
#
# После Task 16:
# {$GLITCHTIP_DOMAIN} {
#     encode zstd gzip
#     basic_auth { admin {$CADDY_BASIC_AUTH_HASH} }
#     reverse_proxy glitchtip-web:8000
# }
#
# После Task 17:
# {$KUMA_DOMAIN} {
#     encode zstd gzip
#     basic_auth { admin {$CADDY_BASIC_AUTH_HASH} }
#     reverse_proxy uptime-kuma:3001
# }
