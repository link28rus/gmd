{
	admin off
	# auto_https default — Caddy сам выпускает Let's Encrypt cert через ACME http-01
	# challenge на :80. Раньше был auto_https off (TLS делал внешний nginx 1.24.0
	# на 95.104.240.99), но v0.35.0-rc.4 переехал на direct prod IP 95.104.240.111
	# (ens192) — TLS теперь делает Caddy.
	# HTTP/3 (QUIC) отключён: prod не пробрасывает UDP 443, и Alt-Svc: h3 в headers
	# заставлял Chrome пытаться QUIC и кэшировать недоступный endpoint.
	servers {
		protocols h1 h2
	}
}

# --- Основной кабинет + API ---
gmd.link28rus.ru {
	encode zstd gzip

	# /healthz — edge liveness (должен идти до всех handle-матчеров)
	handle /healthz {
		respond "OK" 200
	}

	# /download/* — раздача release APK под basic auth
	# User: gmd; пароль хэшируется bcrypt'ом, хранится в {$DOWNLOAD_PASSWORD_HASH}
	# handle_path чтобы strip'нуть /download/ и file_server искал в /srv/download/
	handle_path /download/* {
		basic_auth {
			gmd {$DOWNLOAD_PASSWORD_HASH}
		}
		root * /srv/download
		file_server browse
	}

	# /api/auth/* → web (Next.js route handlers ставят httpOnly refresh cookie)
	handle /api/auth/* {
		reverse_proxy web:3000
	}

	# /api/me (без children) — через web (прокси с Bearer)
	handle /api/me {
		reverse_proxy web:3000
	}

	# /api/children + /api/children/* → web (route handlers проксируют с Bearer)
	@children path /api/children /api/children/*
	handle @children {
		reverse_proxy web:3000
	}

	# /api/admin + /api/admin/* → web (route handlers проксируют с Bearer в /admin/*)
	@admin path /api/admin /api/admin/*
	handle @admin {
		reverse_proxy web:3000
	}

	# /api/healthz — web (уже есть в Next.js)
	handle /api/healthz {
		reverse_proxy web:3000
	}

	# /api/sentry-tunnel — web (Phase 0.4 relay браузер → GlitchTip через gmd_net)
	handle /api/sentry-tunnel {
		reverse_proxy web:3000
	}

	# /api/geocode — web (server-side прокси Yandex Geocoder, ключ только на web)
	handle /api/geocode {
		reverse_proxy web:3000
	}

	# /api/download + /api/download/* — web (list + stream APK из /srv/download, auth)
	@download path /api/download /api/download/*
	handle @download {
		reverse_proxy web:3000
	}

	# /api/public/download* — web (публичный листинг + скачивание APK для лендинга)
	@publicDownload path /api/public/download /api/public/download/*
	handle @publicDownload {
		reverse_proxy web:3000
	}

	# /audio/ws — WebSocket-relay для «Звук вокруг ребёнка» (v0.35).
	# Caddy v2 reverse_proxy автоматически апгрейдит Connection: Upgrade.
	# Большой timeout: read=0 (бесконечно), flush_interval=-1 (для streaming).
	handle /audio/ws {
		reverse_proxy backend:3001 {
			transport http {
				read_timeout 0s
			}
			flush_interval -1
		}
	}

	# Остальное /api/* — напрямую в backend (strip /api prefix)
	handle_path /api/* {
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "interest-cohort=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# --- GlitchTip + Uptime Kuma subdomains ---
# Включаются в Phase 0.3 Task 16/17 через `import` после того как сервисы
# glitchtip-web и uptime-kuma появятся в docker-compose.prod.yml.
# Без этого Caddy пытается получить TLS-сертификат на subdomain и ACME падает,
# либо при обращении выдаёт 502 из-за отсутствия upstream DNS.
#
