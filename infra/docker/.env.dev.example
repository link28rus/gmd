# Development Docker environment
# Copy to .env.dev and adjust if needed

POSTGRES_USER=gmd
POSTGRES_PASSWORD=gmd_dev_password
POSTGRES_DB=gmd_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

ADMINER_PORT=8080

# MailHog (dev SMTP + web UI)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# coturn (TURN-сервер для «Звук вокруг ребёнка»)
TURN_SHARED_SECRET=dev-secret-change-me
TURN_REALM=gmd.local
TURN_PORT=3478
TURN_EXTERNAL_IP=127.0.0.1
# TURN_PUBLIC_HOST/PORT — потребляются backend'ом (apps/backend) для генерации TURN-creds, отдаваемых mobile-клиентам. coturn-сервису не передаются.
TURN_PUBLIC_HOST=127.0.0.1
TURN_PUBLIC_PORT=3478
