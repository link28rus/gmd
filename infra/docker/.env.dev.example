# Development Docker environment
# Copy to .env.dev and adjust if needed

POSTGRES_USER=gmd
POSTGRES_PASSWORD=gmd_dev_password
POSTGRES_DB=gmd_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

ADMINER_PORT=8080

# MailHog (dev SMTP + web UI)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# «Звук вокруг ребёнка» — WebSocket-relay (v0.35).
# AUDIO_WS_SECRET — HS256 ключ для JWT, ≥32 байт. Сгенерировать: openssl rand -base64 48
# AUDIO_WS_PUBLIC_URL — публичный wss://-адрес WS-эндпоинта (для dev: ws://localhost:3001/audio/ws)
# Эти переменные потребляются backend-сервисом, не docker-stack'ом.
# coturn / TURN_* удалены в v0.35.0-rc.4 (Phase 4 Plan E pivot).
