# ==============================================================================
#  GMD prod env (infra/docker/.env.prod.example)
#  Копируется на сервер в /opt/gmd/.env.prod и заполняется секретами.
#  НИКОГДА не коммитить заполненный .env.prod в git.
# ==============================================================================

# --- Postgres (gmd_db) ---
POSTGRES_DB=gmd
POSTGRES_USER=gmd
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# --- MinIO ---
MINIO_ROOT_USER=gmd_minio
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend ---
BACKEND_PORT=3001
JWT_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://gmd.link28rus.ru/api

# --- Caddy ---
CADDY_DOMAIN=gmd.link28rus.ru
CADDY_ACME_EMAIL=admin@link28rus.ru
CADDY_BASIC_AUTH_HASH=__bcrypt_hash__

# --- GlitchTip ---
GLITCHTIP_DOMAIN=errors.gmd.link28rus.ru
GLITCHTIP_SECRET_KEY=__CHANGE_ME__
GLITCHTIP_DB_PASSWORD=__CHANGE_ME__
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_DEFAULT_FROM_EMAIL=errors@gmd.link28rus.ru

# --- Uptime Kuma ---
KUMA_DOMAIN=status.gmd.link28rus.ru

# --- Sentry DSN (заполним после создания проектов в GlitchTip) ---
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
