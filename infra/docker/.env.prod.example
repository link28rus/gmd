# ==============================================================================
#  GMD prod env (infra/docker/.env.prod.example)
#  Копируется на сервер в /opt/gmd/.env.prod и заполняется секретами.
#  НИКОГДА не коммитить заполненный .env.prod в git.
# ==============================================================================

# --- Postgres (gmd_db) ---
POSTGRES_DB=gmd
POSTGRES_USER=gmd
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# --- MinIO ---
MINIO_ROOT_USER=gmd_minio
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Backend ---
BACKEND_PORT=3001
JWT_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api

# --- Caddy ---
CADDY_DOMAIN=gmd.link28rus.ru
CADDY_ACME_EMAIL=admin@link28rus.ru
CADDY_BASIC_AUTH_HASH=__bcrypt_hash__

# --- Invites (Phase 1.2) ---
INVITE_TTL_SECONDS=600
CLAIM_LANDING_BASE_URL=https://gmd.link28rus.ru

# --- Phase 0.4: GlitchTip ---
GLITCHTIP_DB_PASSWORD=<openssl rand -hex 24>
GLITCHTIP_REDIS_PASSWORD=<openssl rand -hex 24>
GLITCHTIP_SECRET_KEY=<openssl rand -hex 32>
GLITCHTIP_DOMAIN=http://localhost:3010
GLITCHTIP_DEFAULT_FROM_EMAIL=GMD GlitchTip <no-reply@gmd.link28rus.ru>
GLITCHTIP_EMAIL_URL=smtp+tls://user:pass@smtp.example.com:587
GLITCHTIP_ENABLE_USER_REGISTRATION=True
GLITCHTIP_EVENT_RETENTION_DAYS=30
GLITCHTIP_CELERY_WORKER_CONCURRENCY=2

# DSN-ключи (заполняются после Task 5)
SENTRY_DSN_BACKEND=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN=

# --- Phase 0.4: Uptime Kuma ---
KUMA_BACKUP_HEARTBEAT_URL=
KUMA_DISK_HEARTBEAT_URL=

# --- Phase 0.4: Telegram-бот для алертов ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
