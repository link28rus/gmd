[Unit]
Description=GMD disk-space heartbeat to Uptime Kuma
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/gmd-disk-heartbeat
ExecStart=/opt/gmd/bin/disk-heartbeat.sh
# Не падаем при разовых сбоях curl — Uptime Kuma сам поймёт что heartbeat
# пропал (window 15 мин), retries не нужны.
SuccessExitStatus=0 1 2
